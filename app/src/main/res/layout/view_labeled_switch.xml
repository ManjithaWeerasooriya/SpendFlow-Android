<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/sf_icon_size"
        android:layout_height="@dimen/sf_icon_size"
        android:layout_marginEnd="@dimen/sf_space_l"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:src="@drawable/ic_streak"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SpendFlow.Body"
            android:textColor="?attr/sfColorTextHeading"
            android:textSize="16sp"
            tools:text="Tracking streak" />

        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SpendFlow.BodyMedium"
            android:textColor="?attr/sfColorTextMuted"
            android:visibility="gone"
            tools:text="Off hides streak badges and reminders everywhere"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/sf_space_m"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.SpendFlow.Label"
        android:textColor="?attr/sfColorTextMuted"
        tools:text="@string/switch_on" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:saveEnabled="false" />
</merge>
