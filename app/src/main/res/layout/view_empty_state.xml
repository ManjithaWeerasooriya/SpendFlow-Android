<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:gravity="center_horizontal"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <FrameLayout
        android:layout_width="@dimen/sf_empty_icon_size"
        android:layout_height="@dimen/sf_empty_icon_size"
        android:background="@drawable/bg_circle_tint">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_transactions" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sf_space_xl"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SpendFlow.SectionTitle"
        android:textColor="?attr/sfColorTextHeading"
        tools:text="No transactions yet" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sf_space_s"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SpendFlow.Body"
        android:textColor="?attr/sfColorTextMuted"
        tools:text="Entries you add for October will show up here." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sf_space_xxl"
        android:visibility="gone"
        tools:text="Add transaction"
        tools:visibility="visible" />
</merge>
