<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary button: violet pill. Set as materialButtonStyle, so a plain <Button> gets it. -->
    <style name="Widget.SpendFlow.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/sf_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/sf_space_xxl</item>
        <item name="android:paddingEnd">@dimen/sf_space_xxl</item>
        <item name="android:textAppearance">@style/TextAppearance.SpendFlow.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SpendFlow.Pill</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/sf_space_s</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="Widget.SpendFlow.Button.Destructive">
        <item name="backgroundTint">@color/sf_button_destructive_bg</item>
        <item name="android:textColor">@color/sf_button_destructive_text</item>
        <item name="iconTint">@color/sf_button_destructive_text</item>
    </style>

    <style name="Widget.SpendFlow.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/sf_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/sf_space_xxl</item>
        <item name="android:paddingEnd">@dimen/sf_space_xxl</item>
        <item name="android:textAppearance">@style/TextAppearance.SpendFlow.Button</item>
        <item name="android:textColor">?attr/sfColorTextHeading</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SpendFlow.Pill</item>
    </style>

    <!-- Cards: a shell holds sections; inset cards sit inside a shell -->
    <style name="Widget.SpendFlow.CardShell" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/sfColorCardShell</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SpendFlow.CardShell</item>
        <item name="contentPadding">@dimen/sf_space_l</item>
    </style>

    <style name="Widget.SpendFlow.InsetCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/sfColorInsetCard</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/sf_stroke_hairline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SpendFlow.InsetCard</item>
        <item name="contentPadding">@dimen/sf_space_l</item>
    </style>

    <!-- Snackbar: dark pill with a filled action, as in "Saved · Groceries LKR 2,450 [Undo]" -->
    <style name="Widget.SpendFlow.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorSurfaceInverse</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SpendFlow.Sheet</item>
        <item name="android:layout_margin">@dimen/sf_space_l</item>
    </style>

    <style name="Widget.SpendFlow.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textAppearance">@style/TextAppearance.SpendFlow.Body</item>
        <item name="android:textColor">?attr/colorOnSurfaceInverse</item>
    </style>

    <style name="Widget.SpendFlow.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="backgroundTint">?attr/sfColorSnackbarAction</item>
        <item name="android:textColor">?attr/colorOnSurfaceInverse</item>
        <item name="android:textAppearance">@style/TextAppearance.SpendFlow.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SpendFlow.Pill</item>
        <item name="android:paddingStart">@dimen/sf_space_xl</item>
        <item name="android:paddingEnd">@dimen/sf_space_xl</item>
    </style>

    <!-- Bottom bar (02a): white bar with rounded top corners; the selected tab darkens instead of a pill -->
    <style name="Widget.SpendFlow.BottomBar" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/sfColorInsetCard</item>
        <item name="elevation">@dimen/sf_bottom_bar_elevation</item>
        <item name="itemIconTint">@color/sf_bottom_bar_item</item>
        <item name="itemTextColor">@color/sf_bottom_bar_item</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.SpendFlow.NavLabel</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.SpendFlow.NavLabel.Active</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- The central +: the most prominent element on every main screen -->
    <style name="Widget.SpendFlow.AddButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="fabCustomSize">@dimen/sf_add_button_size</item>
        <item name="maxImageSize">@dimen/sf_add_icon_size</item>
        <item name="backgroundTint">?attr/sfColorViolet</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="srcCompat">@drawable/ic_plus</item>
        <item name="elevation">4dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SpendFlow.Pill</item>
    </style>

    <!-- Pushed screens (07a, 08a): back chevron and a centred title -->
    <style name="Widget.SpendFlow.TopBar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="navigationIcon">@drawable/ic_chevron_left</item>
        <item name="navigationContentDescription">@string/action_back</item>
        <item name="titleCentered">true</item>
        <item name="titleTextAppearance">@style/TextAppearance.SpendFlow.TopBarTitle</item>
        <item name="titleTextColor">?attr/sfColorTextHeading</item>
    </style>

    <!-- Tappable row in a card, as on Settings and More -->
    <style name="Widget.SpendFlow.LinkRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/sf_link_row_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/sf_space_l</item>
        <item name="android:paddingEnd">@dimen/sf_space_l</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.SpendFlow.LinkRow.Icon" parent="">
        <item name="android:layout_width">@dimen/sf_icon_size</item>
        <item name="android:layout_height">@dimen/sf_icon_size</item>
        <item name="android:layout_marginEnd">@dimen/sf_space_l</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">?attr/sfColorTextHeading</item>
    </style>

    <style name="Widget.SpendFlow.LinkRow.Title" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.SpendFlow.Body</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/sfColorTextHeading</item>
    </style>

    <style name="Widget.SpendFlow.LinkRow.Chevron" parent="">
        <item name="android:layout_width">@dimen/sf_icon_size</item>
        <item name="android:layout_height">@dimen/sf_icon_size</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
    </style>
</resources>
