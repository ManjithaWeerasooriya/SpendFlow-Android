<resources>
    <!-- DayNight follows the phone setting; color resources provide the palette. -->
    <style name="Base.Theme.SpendFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sf_primary_violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/sf_lavender</item>
        <item name="colorOnPrimaryContainer">@color/sf_ink</item>
        <item name="colorSecondary">@color/sf_lavender</item>
        <item name="colorOnSecondary">@color/sf_ink</item>
        <item name="colorSecondaryContainer">@color/sf_lavender</item>
        <item name="colorOnSecondaryContainer">@color/sf_ink</item>

        <item name="colorError">@color/sf_over_cap</item>
        <item name="colorOnError">@color/black</item>

        <item name="android:colorBackground">@color/sf_page</item>
        <item name="android:windowBackground">@color/sf_page</item>
        <item name="colorOnBackground">@color/sf_body_text</item>
        <item name="colorSurface">@color/sf_card_shell</item>
        <item name="colorOnSurface">@color/sf_body_text</item>
        <item name="colorSurfaceVariant">@color/sf_inset_card</item>
        <item name="colorOnSurfaceVariant">@color/sf_body_text</item>
        <item name="colorSurfaceDim">@color/sf_page</item>
        <item name="colorSurfaceBright">@color/sf_inset_card</item>
        <item name="colorSurfaceContainerLowest">@color/sf_page</item>
        <item name="colorSurfaceContainerLow">@color/sf_card_shell</item>
        <item name="colorSurfaceContainer">@color/sf_card_shell</item>
        <item name="colorSurfaceContainerHigh">@color/sf_inset_card</item>
        <item name="colorSurfaceContainerHighest">@color/sf_inset_card</item>

        <item name="android:textColorPrimary">@color/sf_body_text</item>
        <item name="android:textColorSecondary">@color/sf_body_text</item>
    </style>

    <style name="Theme.SpendFlow" parent="Base.Theme.SpendFlow" />
</resources>
