<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity picks the start graph from the session and switches between them on sign-in/out and after onboarding -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_root"
    app:startDestination="@id/auth_graph">

    <include app:graph="@navigation/auth_graph" />
    <include app:graph="@navigation/onboarding_graph" />
    <include app:graph="@navigation/main_graph" />
</navigation>
