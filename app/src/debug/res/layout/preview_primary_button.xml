<?xml version="1.0" encoding="utf-8"?>
<!-- Preview in light and dark: Layout Editor > Night Mode, or run ComponentGalleryActivity -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/previewPrimaryButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="@dimen/sf_screen_padding">

    <Button
        android:id="@+id/primaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/sf_space_m"
        android:text="Add transaction"
        app:icon="@drawable/ic_add_mono" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sf_space_m"
        android:orientation="horizontal">

        <Button
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/sf_space_s"
            android:layout_weight="1"
            android:text="Cancel" />

        <Button
            style="@style/Widget.SpendFlow.Button.Destructive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sf_space_s"
            android:layout_weight="1"
            android:text="Delete" />
    </LinearLayout>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sf_space_m"
        android:enabled="false"
        android:text="Save (disabled)" />
</LinearLayout>
