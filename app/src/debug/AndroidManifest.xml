<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 17+ blocks connections to LAN addresses (incl. the emulator host 10.0.2.2)
         without this. Only needed to reach the local Firebase emulators. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Design-system gallery; exported so it can be opened with `adb shell am start` -->
        <activity
            android:name=".gallery.ComponentGalleryActivity"
            android:exported="true"
            android:label="Components" />
    </application>

</manifest>
