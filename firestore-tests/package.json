{
  "name": "spendflow-firestore-tests",
  "private": true,
  "description": "Security rules tests for firestore.rules, run against the Firestore emulator",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-spendflow \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0"
  }
}
